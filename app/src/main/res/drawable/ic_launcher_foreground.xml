<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft ambient drop shadow underneath main symbol -->
    <path
        android:pathData="M31,80 C31,80 43,45 43,36 C43,27 48,21 54,21 C60,21 65,27 65,36 C65,45 77,80 77,80"
        android:strokeWidth="11"
        android:strokeColor="#25000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Main 'A' + Location Pin Outer Frame in Sky Blue (#38BDF8) -->
    <!-- Slanted legs of 'A' that merge smoothly into a rounded location pin dome top -->
    <path
        android:pathData="M31,80 C31,80 43,45 43,36 C43,27 48,21 54,21 C60,21 65,27 65,36 C65,45 77,80 77,80"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="31"
                android:startY="80"
                android:endX="77"
                android:endY="21"
                android:type="linear">
                <item android:color="#38BDF8" android:offset="0.0" />
                <item android:color="#0EA5E9" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central Location Pin Teardrop dropping down to pin point (Sky Blue) -->
    <path
        android:pathData="M54,36 C54,36 44,48 44,56 C44,63 54,77 54,77 C54,77 64,63 64,56 C64,48 54,36 54,36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="36"
                android:endX="54"
                android:endY="77"
                android:type="linear">
                <item android:color="#38BDF8" android:offset="0.0" />
                <item android:color="#0284C7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Pin Core Hole cutout (Dark Navy #0F172A) -->
    <path
        android:fillColor="#0F172A"
        android:pathData="M54,52m-5.5,0a5.5,5.5 0 1,0 11,0a5.5,5.5 0 1,0 -11,0" />

    <!-- Dynamic Emerald Route Line (#34D399) passing across 'A' crossbar -->
    <path
        android:pathData="M22,68 C27,60 34,57 41,57 H67 C74,57 81,51 83,39"
        android:strokeWidth="4"
        android:strokeColor="#34D399"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Route Waypoint Node 1: Origin (Emerald #34D399 with White Core) -->
    <path
        android:fillColor="#34D399"
        android:pathData="M22,68m-4,0a4,4 0 1,0 8,0a4,4 0 1,0 -8,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M22,68m-1.5,0a1.5,1.5 0 1,0 3,0a1.5,1.5 0 1,0 -3,0" />

    <!-- Route Waypoint Node 2: Center Crossbar Node (Emerald #34D399) -->
    <path
        android:fillColor="#34D399"
        android:pathData="M54,57m-3,0a3,3 0 1,0 6,0a3,3 0 1,0 -6,0" />

    <!-- Route Waypoint Node 3: Destination Node at Pin Head (Emerald #34D399 with Sky Blue Core) -->
    <path
        android:fillColor="#34D399"
        android:pathData="M54,34m-4.5,0a4.5,4.5 0 1,0 9,0a4.5,4.5 0 1,0 -9,0" />
    <path
        android:fillColor="#38BDF8"
        android:pathData="M54,34m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0" />

