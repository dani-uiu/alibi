<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Saved places can include private addresses (e.g. "Home"), so they never
     go to cloud backup. A direct device-to-device transfer (new phone) still carries them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="custom_locations_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
